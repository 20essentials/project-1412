---
import { baseUrl } from '@/utils/functions';

const TOTAL_VIDEOS = 2;
const VIDEOS = Array.from({ length: TOTAL_VIDEOS }, (_, index) => ({
  src: baseUrl(`/assets/videos/v${index + 1}.mp4`),
  zIndex: index === 0 ? 1 : 0,
  autoplay: index === 0
}));
---

<section class='am-main-container'>
  <aside class='container'>
    {
      VIDEOS.map(video => (
        <video
          src={video.src}
          class='am-video'
          muted
          playsinline
          preload='auto'
          autoplay={video.autoplay}
          style={{ zIndex: video.zIndex }}
        />
      ))
    }
  </aside>
</section>

<style>
  .am-main-container {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-wrap: wrap;
    place-content: center;
    --grow: 3.4;
    --final-state: inset(100% 0 0 0);
    --current-index: 1;
    --hide-duration: 1000ms;

    .container {
      width: calc(16vmax * var(--grow));
      height: calc(9vmax * var(--grow));
      position: relative;
      clip-path: inset(0 0 0 0);
      transition: clip-path 1s ease-in-out;

      @starting-style {
        clip-path: var(--final-state);
      }

      video {
        width: 100%;
        height: 100%;
        position: absolute;
      }
    }
  }

  @keyframes hide {
    0% {
      clip-path: inset(0 0 0 0);
    }
    100% {
      clip-path: if(
        style(--current-index: 1): inset(100% 0 0 0) ;
          style(--current-index: 2): inset(0 100% 0 0) ;
          style(--current-index: 3): inset(0 0 100% 0) ;
          style(--current-index: 4): inset(0 0 0 100%) ;
          style(--current-index: 5): inset(100% 0 0 0) ;
          style(--current-index: 6): inset(0 100% 0 0) ; else: inset(0 100% 0 0) ;
      );
    }
  }
</style>

<script>
  import { $, $$, baseUrl } from '@/utils/functions';
  const $container = $('.am-main-container');
  const $videos = $$<HTMLVideoElement>('.am-video');
  const TOTAL_CLIPS = 6;
  const HIDE_MS =
    parseFloat(getComputedStyle($container).getPropertyValue('--hide-duration')) || 1000;
  const HEAD_START_MS = 250;

  let top = $videos[0];
  let bottom = $videos[1];
  let current = 1;

  function nextClip() {
    return (current % TOTAL_CLIPS) + 1;
  }

  function preloadNext() {
    const next = nextClip();
    bottom.src = baseUrl(`/assets/videos/v${next}.mp4`);
    bottom.load();
  }

  function cycle() {
    const next = nextClip();

    bottom.style.zIndex = '0';
    bottom.style.animation = 'none';
    bottom.currentTime = 0;

    top.style.zIndex = '1';
    top.style.animation = `hide ${HIDE_MS}ms ease-in-out forwards`;

    const previewTimer = window.setTimeout(() => {
      bottom.play().catch(() => undefined);
    }, HIDE_MS - HEAD_START_MS);

    top.addEventListener(
      'animationend',
      () => {
        window.clearTimeout(previewTimer);
        [top, bottom] = [bottom, top];
        current = next;
        $container.style.setProperty('--current-index', String(next));
        preloadNext();
      },
      { once: true }
    );
  }

  top.addEventListener('ended', cycle);
  bottom.addEventListener('ended', cycle);

  preloadNext();
</script>