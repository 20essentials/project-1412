---
import { baseUrl } from '@/utils/functions';
const TOTAL_VIDEOS = 2;
---

<section class='am-main-container'>
  <aside class='container'>
    {
      Array.from({ length: TOTAL_VIDEOS }, (_, i) => {
        const isFirstVideo = i === 0;
        return (
          <video
            src={baseUrl(`/assets/videos/v${i + 1}.mp4`)}
            class={`am-video`}
            autoplay={isFirstVideo}
            muted
            style={{
              zIndex: isFirstVideo ? 1 : 0
            }}
          />
        );
      })
    }
  </aside>
</section>

<style>
  .am-main-container {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-wrap: wrap;
    place-content: center;
    --grow: 3.4;
    --final-state: inset(100% 0 0 0);
    --current-index: 1;

    .container {
      width: calc(16vmax * var(--grow));
      height: calc(9vmax * var(--grow));
      position: relative;
      clip-path: inset(0 0 0 0);
      transition: clip-path 1s ease-in-out;

      @starting-style {
        clip-path: var(--final-state);
      }

      video {
        width: 100%;
        height: 100%;
        position: absolute;
      }
    }
  }

  @keyframes hide {
    0% {
      clip-path: inset(0 0 0 0);
    }
    100% {
      clip-path: if(
        style(--current-index: 1): inset(100% 0 0 0) ;
          style(--current-index: 2): inset(0 100% 0 0) ;
          style(--current-index: 3): inset(0 0 100% 0) ;
          style(--current-index: 4): inset(0 0 0 100%) ;
          style(--current-index: 5): inset(100% 0 0 0) ;
          style(--current-index: 6): inset(0 100% 0 0) ; else: inset(0 100% 0 0) ;
      );
    }
  }
</style>

<script>
  import { $, $$, baseUrl } from '@/utils/functions';
  const [$video1, $video2] = $$<HTMLVideoElement>('.am-video');
  let currentIndexVideo = 1;
  const MAX_VIDEOS = 6;
  const $mainContainer = $(' .am-main-container');

  function hideVideo({
    video,
    video_2
  }: {
    video: HTMLVideoElement;
    video_2: HTMLVideoElement;
  }) {
    video.style.animation = 'hide 1s ease-in-out forwards';
    video.addEventListener('animationend', () => {
      const nextIndex = (currentIndexVideo % MAX_VIDEOS) + 1;
      video_2.src = baseUrl(`/assets/videos/v${nextIndex}.mp4`);
      currentIndexVideo = nextIndex;
      $mainContainer.style.setProperty('--current-index', String(nextIndex));
      video_2.style.zIndex = '1';
      video_2.play();
      video.style.zIndex = '0';
      video.style.animation = 'none';
    });
  }

  $video2.addEventListener('ended', () => {
    hideVideo({
      video: $video2,
      video_2: $video1
    });
  });

  $video1.addEventListener('ended', () => {
    hideVideo({
      video: $video1,
      video_2: $video2
    });
  });
</script>
